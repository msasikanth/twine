import kotlin.time.Instant;

CREATE TABLE postContent (
  id TEXT NOT NULL PRIMARY KEY,
  feedContent TEXT,
  articleContent TEXT,
  feedContentLen INTEGER,
  createdAt INTEGER AS Instant NOT NULL,
  feedContentReadingTime INTEGER DEFAULT NULL,
  articleContentReadingTime INTEGER DEFAULT NULL
);

upsert:
INSERT INTO postContent (id, feedContent, feedContentLen, articleContent, createdAt, feedContentReadingTime, articleContentReadingTime)
VALUES (:id, :feedContent, :feedContentLen, :articleContent, :createdAt, :feedContentReadingTime, :articleContentReadingTime)
ON CONFLICT (id) DO UPDATE SET
  feedContent = CASE WHEN COALESCE(postContent.feedContentLen, 0) < COALESCE(length(excluded.feedContent), 0) THEN excluded.feedContent ELSE postContent.feedContent END,
  feedContentLen = CASE WHEN COALESCE(postContent.feedContentLen, 0) < COALESCE(length(excluded.feedContent), 0) THEN excluded.feedContentLen ELSE postContent.feedContentLen END,
  feedContentReadingTime = CASE WHEN COALESCE(postContent.feedContentLen, 0) < COALESCE(length(excluded.feedContent), 0) THEN excluded.feedContentReadingTime ELSE postContent.feedContentReadingTime END,
  articleContent = COALESCE(excluded.articleContent, postContent.articleContent),
  articleContentReadingTime = COALESCE(excluded.articleContentReadingTime, postContent.articleContentReadingTime);

getByPostId:
SELECT * FROM postContent
WHERE id = :id;

updateArticleContent:
UPDATE postContent SET articleContent = :articleContent, articleContentReadingTime = :articleContentReadingTime
WHERE id = :id;

deleteAll:
DELETE FROM postContent;
